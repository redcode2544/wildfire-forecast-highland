def HotSpotID(SatSN,Lat,Lng,UTCdate):
    GeoRef = arcpy.SpatialReference(4326)
    SAT = SatSN
    #UTCD = datetime.date.fromisoformat(UTCdate) #chang for arcpro
    #TDate = str(UTCdate.year) + str(UTCdate.month).zfill(2) + str(UTCdate.day).zfill(2)
    #TDate =  UTCdate.strftime("%Y%m%d")
    pnt =  arcpy.Point(Lat,Lng)
    pnt_geometry = arcpy.PointGeometry(pnt, GeoRef)
    GeoID = pnt_geometry.getGeohash (10)
    HS_ID = SAT + UTCdate + GeoID
    return HS_ID
